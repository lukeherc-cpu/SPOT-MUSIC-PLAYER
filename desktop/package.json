{
  "name": "spot-music-desktop",
  "productName": "Cadence",
  "version": "0.2.0-alpha.1",
  "description": "Music discovery and podcast player with Spotify catalog integration",
  "author": "Cadence contributors",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.mjs",
    "test:ui": "playwright test",
    "prepare:resolver": "node scripts/resolver.mjs",
    "prepare:speech": "python3 ../scripts/prepare_speech.py --desktop",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1",
    "hls.js": "1.7.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.lukeherc.spotmusic.desktop",
    "asar": true,
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {"from":"resources/speech","to":"speech"},
      {
        "from": "resources/resolver",
        "to": "resolver"
      },
      {
        "from": "../docs/licenses",
        "to": "licenses"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/Cadence-AGPL-3.0.txt"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "licenses/Desktop-THIRD-PARTY.md"
      },
      {
        "from": "node_modules/hls.js/LICENSE",
        "to": "licenses/HLS-js-BSD-2-Clause.txt"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Cadence-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "identity": null,
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "resources/icon.png",
      "maintainer": "Cadence contributors",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/lukeherc-cpu/SPOT-MUSIC-PLAYER",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeherc-cpu/SPOT-MUSIC-PLAYER.git"
  },
  "desktopName": "spot-music.desktop"
}
